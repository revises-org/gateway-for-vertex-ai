# Copy to ~/.config/gateway-for-vertex-ai/env and chmod 600.
# systemd reads this file literally — no quotes, no "export".

GCP_PROJECT_ID=my-project

# "global" gives the best capacity; use a region if you need data residency.
GCP_LOCATION=global

BIND_ADDR=127.0.0.1:8787

# Generate once with: openssl rand -hex 16
# Paste the same value into your editor's API key field.
GATEWAY_API_KEY=replace-me

# --- Google Cloud credentials ---
# Leave unset to use Application Default Credentials
# (~/.config/gcloud/application_default_credentials.json).
# A service account key is more stable for a long-running service:
#GOOGLE_APPLICATION_CREDENTIALS=/home/you/.config/gateway-for-vertex-ai/sa.json

# --- Optional ---
#MODEL_ALIASES={"gemini-pro":"google/gemini-2.5-pro","gemini-flash":"google/gemini-2.5-flash"}
#RUST_LOG=gateway_for_vertex_ai=info
